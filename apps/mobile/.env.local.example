# Dev-client env. Copy to `.env.local` and fill in. Metro inlines EXPO_PUBLIC_* into the bundle;
# NGROK_* are read by tunnel.js (not inlined). Source real values from your password manager.

# --- Required ---
EXPO_PUBLIC_API_URL=<reachable-api-url>/api/v1   # reachable from the phone: live backend or <tunnel URL>/api/v1 (local backend)

# --- Tunnel (only for tunnel.js; Expo's tunnel doesn't need these) ---
NGROK_AUTHTOKEN=<ngrok-authtoken>                # ngrok dashboard -> Your Authtoken
NGROK_API_KEY=<ngrok-api-key>                    # optional: force-kills stale endpoints (avoids ERR_NGROK_334)

# --- Local backend (README -> "Local backend with mock data") ---
# LOCAL_BACKEND_URL=http://localhost:3100       # Metro forwards /api + storage requests to the local stack

# --- Optional (dev quality-of-life) ---
EXPO_PUBLIC_LOGIN_FORM_EMAIL=user@example.com    # prefill the login screen
EXPO_PUBLIC_LOGIN_FORM_PASSWORD=password
EXPO_PUBLIC_SENTRY_DEBUG=true                    # Sentry debug logging
EXPO_PUBLIC_OPENAI_API_KEY=<openai-key>          # AI captions only; NOTE: ships baked into the bundle
