# Dev-client env. Copy to `.env.local` and fill in, or let `npm run dev:live` / `dev:local` (or
# scripts/check-env.sh) write it from the environment variables. Metro inlines EXPO_PUBLIC_* into
# the bundle.

# --- Required ---
EXPO_PUBLIC_API_URL=https://squidbox-server.fly.dev/api/v1   # live backend; `npm run dev:local` uses the local one instead

# --- Optional (dev quality-of-life) ---
EXPO_PUBLIC_LOGIN_FORM_EMAIL=user@example.com    # prefill the login screen (overrides dev:local's local login)
EXPO_PUBLIC_LOGIN_FORM_PASSWORD=password
EXPO_PUBLIC_SENTRY_DEBUG=true                    # Sentry debug logging
EXPO_PUBLIC_OPENAI_API_KEY=<openai-key>          # AI captions only; NOTE: ships baked into the bundle
