{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    // No JavaScript in the app (expo/tsconfig.base turns it on). migrations.js, drizzle-kit's output,
    // is typed by the migrations.d.ts beside it.
    "allowJs": false,
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@squidbox/shared": [
        "../../packages/shared/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
