# Native project output — GENERATED by `expo prebuild` / `expo run:ios|android` (CNG). It is not
# source: app.config.js + config plugins are the source of truth, and these dirs are regenerable
# with `expo prebuild --clean`. Keeping them ignored preserves the managed Expo workflow (no eject).
/ios
/android

# Expo local state
/.expo

# The installed build's client code (the baseline's commit), extracted by test/installedBuilds.e2e.test.ts
/test/.builds

# Playwright output of the UI flow tests (npm run test:ui)
/test-results
