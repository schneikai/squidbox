{
  "name": "squidbox",
  "version": "1.0.0",
  "main": "index.js",
  "expo": {
    "install": {
      "//": "Pin @sentry/react-native to 8.x. SDK 55's expo-doctor expects ~7.11, but 8.x works and downgrading a major is breaking; excluding it stops `expo install --fix` from reverting it. Revisit on SDK bump.",
      "exclude": [
        "@sentry/react-native"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck:sync": "tsc -p tsconfig.synccheck.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "TEST_DATABASE_URL=postgres://squidbox:squidbox@localhost:5432/squidbox vitest run"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.12",
    "@expo/react-native-action-sheet": "^4.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.16",
    "@react-navigation/stack": "^6.3.20",
    "@sentry/react-native": "^8.4.0",
    "@squidbox/shared": "*",
    "axios": "^1.6.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "drizzle-orm": "^0.38.4",
    "expo": "~55.0.31",
    "expo-blur": "~55.0.18",
    "expo-clipboard": "~55.0.17",
    "expo-dev-client": "~55.0.40",
    "expo-file-system": "~55.0.26",
    "expo-image": "~55.0.11",
    "expo-image-manipulator": "~55.0.21",
    "expo-image-picker": "~55.0.24",
    "expo-linear-gradient": "~55.0.18",
    "expo-media-library": "~55.0.21",
    "expo-secure-store": "~55.0.18",
    "expo-splash-screen": "~55.0.25",
    "expo-sqlite": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-video": "~55.0.21",
    "expo-video-thumbnails": "~55.0.19",
    "lucide-react-native": "1.7.0",
    "moment": "^2.29.4",
    "ngrok": "^5.0.0-beta.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-double-tap": "^1.0.1",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-popup-menu": "^0.19.0",
    "react-native-reanimated": "4.2.1",
    "react-native-redash": "^18.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-uuid": "^2.0.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4",
    "yup": "^1.3.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "~19.2.0",
    "babel-plugin-inline-import": "^3.0.0",
    "better-sqlite3": "^11.10.0",
    "drizzle-kit": "^0.30.6",
    "eslint-config-universe": "^12.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  },
  "private": true
}
