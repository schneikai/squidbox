{
  "name": "squidbox",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:preview": "node scripts/webPreview.mjs",
    "web:measure": "node scripts/measurePerformance.mjs",
    "lint": "npm run lint:files -- .",
    "lint:files": "eslint --max-warnings 0 --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo && tsc -p tsconfig.test.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck-test.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "playwright test",
    "test:e2e": "TEST_DATABASE_URL=postgres://squidbox:squidbox@localhost:5432/squidbox vitest run"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/react-native-action-sheet": "^4.0.1",
    "@expo/ui": "~58.0.28",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~8.28.0",
    "@squidbox/shared": "*",
    "axios": "^1.21.1",
    "drizzle-orm": "^0.38.4",
    "expo": "~58.0.25",
    "expo-blur": "~58.0.6",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.20",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-media-library": "~58.0.14",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.17",
    "expo-symbols": "~58.0.5",
    "expo-updates": "~58.0.20",
    "expo-video": "~58.0.14",
    "expo-video-thumbnails": "~58.0.3",
    "lucide-react-native": "1.72.0",
    "moment": "^2.31.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-popup-menu": "^0.19.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-uuid": "^2.0.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@eslint/compat": "^2.1.1",
    "@expo/fingerprint": "~0.21.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "babel-plugin-inline-import": "^3.0.0",
    "better-sqlite3": "^13.1.1",
    "drizzle-kit": "^0.30.6",
    "eslint-config-universe": "^16.1.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "pg": "^8.23.1",
    "playwright": "1.65.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "private": true
}
