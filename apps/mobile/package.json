{
  "name": "squidbox",
  "version": "1.0.0",
  "main": "index.js",
  "expo": {
    "install": {
      "//": "Pin @sentry/react-native to 8.x. SDK 55's expo-doctor expects ~7.11, but 8.x works and downgrading a major is breaking; excluding it stops `expo install --fix` from reverting it. Revisit on SDK bump.",
      "exclude": [
        "@sentry/react-native"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:preview": "node scripts/webPreview.mjs",
    "web:measure": "node scripts/measurePerformance.mjs",
    "lint": "npm run lint:files -- .",
    "lint:files": "eslint --max-warnings 0 --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "typecheck": "tsc -p tsconfig.synccheck.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/synccheck.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "TEST_DATABASE_URL=postgres://squidbox:squidbox@localhost:5432/squidbox vitest run"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@expo/react-native-action-sheet": "^4.0.1",
    "@expo/ui": "~57.0.26",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.16",
    "@sentry/react-native": "^8.4.0",
    "@squidbox/shared": "*",
    "axios": "^1.6.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "drizzle-orm": "^0.38.4",
    "expo": "~57.0.31",
    "expo-blur": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-media-library": "~57.0.5",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-video": "~57.0.5",
    "expo-video-thumbnails": "~57.0.2",
    "lucide-react-native": "1.7.0",
    "moment": "^2.29.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-popup-menu": "^0.19.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-uuid": "^2.0.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@expo/ngrok": "^4.1.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "~19.2.0",
    "babel-plugin-inline-import": "^3.0.0",
    "better-sqlite3": "^11.10.0",
    "drizzle-kit": "^0.30.6",
    "eslint-config-universe": "^12.0.0",
    "pg": "^8.23.1",
    "playwright": "1.56.1",
    "typescript": "~6.0.3",
    "vitest": "^2.1.9"
  },
  "private": true
}
