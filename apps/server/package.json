{
  "name": "@squidbox/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "node --env-file=.env --watch --import tsx src/index.ts",
    "start": "node --env-file=.env --import tsx src/index.ts",
    "start:prod": "node --import tsx src/index.ts",
    "migrate:prod": "node --import tsx src/db/migrate.ts",
    "seed:mock": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node --env-file=.env --import tsx scripts/seed-mock.ts",
    "user:features:prod": "node --import tsx scripts/user-features.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "TEST_DATABASE_URL=postgres://squidbox:squidbox@localhost:5432/squidbox vitest run",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down",
    "compose:reset": "docker compose down -v",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env --import tsx src/db/migrate.ts",
    "db:seed": "node --env-file=.env --import tsx src/db/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "user:features": "node --env-file=.env --import tsx scripts/user-features.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.705.0",
    "@aws-sdk/lib-storage": "^3.705.0",
    "@aws-sdk/s3-request-presigner": "^3.705.0",
    "@fastify/rate-limit": "^10.2.2",
    "@neondatabase/serverless": "^1.2.0",
    "@squidbox/shared": "*",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.1",
    "fastify-type-provider-zod": "^4.0.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.8"
  }
}
