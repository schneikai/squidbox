# apps/server config — copy to .env and fill in. Never commit .env.
# Loaded via Node's built-in --env-file (see package.json scripts) or your shell.

# --- HTTP ---
PORT=3100
HOST=0.0.0.0
LOG_LEVEL=info

# --- Auth ---
# Share the Rails secret_key_base so existing access tokens still validate signature-wise.
# (Existing *refresh* tokens won't exist in the new per-device table → forced re-login at
# cutover; that's a Phase 5 concern, recommended in fable-review.)
JWT_SECRET=<rails secret_key_base>

# --- Postgres ---
DATABASE_URL=postgres://user:pass@localhost:5432/squidbox

# --- AWS / S3 ---
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=<aws access key id>
AWS_SECRET_ACCESS_KEY=<aws secret access key>
# Shared multi-tenant bucket for NEW users (created manually — never auto-created).
# Existing user keeps their legacy per-user bucket via users.storage_bucket.
S3_SHARED_BUCKET=<shared multi-tenant bucket>

# Local dev only (MinIO/LocalStack). Leave BOTH unset for real AWS.
# For the docker-compose stack use .env.docker instead (cp .env.docker .env).
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true

# --- Seeding (db:seed) — the one existing account + a fixture user for isolation tests ---
# The existing user keeps their legacy bucket; provide either a bcrypt digest (imported from
# Rails) OR a plaintext password to hash.
SEED_USER_EMAIL=<existing user email>
SEED_USER_PASSWORD=<existing user password, or leave blank if using digest>
SEED_USER_PASSWORD_DIGEST=<existing bcrypt digest from Rails, optional>
SEED_USER_STORAGE_BUCKET=<existing legacy per-user bucket>
# Second, isolated fixture user (shared bucket + prefix) for multi-tenant isolation tests.
SEED_FIXTURE_EMAIL=fixture@example.com
SEED_FIXTURE_PASSWORD=fixture-password
