# Ready-to-run LOCAL config for the docker-compose stack (Postgres + MinIO).
# Usage:  cp .env.docker .env  &&  npm run local:setup  &&  npm run smoke
# All values here are LOCAL-ONLY throwaway credentials — safe to commit.

PORT=3100
HOST=0.0.0.0
LOG_LEVEL=info

# Any secret works locally.
JWT_SECRET=local-dev-secret

# Postgres from docker-compose
DATABASE_URL=postgres://squidbox:squidbox@localhost:5432/squidbox

# MinIO (S3-compatible) from docker-compose — path-style + local endpoint
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_ENDPOINT: set by `npm run dev:local` (repo root) to Metro's tunnel URL
S3_SHARED_BUCKET=squidbox-shared

# Seed: existing user (keeps a legacy bucket, created by compose) + isolation fixture user
SEED_USER_EMAIL=me@example.com
SEED_USER_PASSWORD=password123
SEED_USER_STORAGE_BUCKET=squidbox-legacy
SEED_FIXTURE_EMAIL=fixture@example.com
SEED_FIXTURE_PASSWORD=fixture-password

# Stable identity of this server, reported by /up, login and /me. The app binds a session and its
# library to it, so keep it fixed per deployment (any uuid; this one is for the local stack).
SERVER_ID=6f0c2d8a-3b1e-4c5a-9d7e-2a1b3c4d5e6f

# AI: Venice API key; without it the server runs and AI endpoints answer 503 ai_not_configured.
# Never commit a real key: export it in your shell (npm run dev:local passes it through).
# VENICE_API_KEY=
