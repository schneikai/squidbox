{
  "name": "squidbox-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run --workspace apps/mobile start",
    "dev:local": "node scripts/dev.mjs",
    "ios:app": "node scripts/iosAppBuild.mjs",
    "lint": "npm run --workspace apps/mobile lint",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "knip": "knip",
    "format": "node scripts/check.mjs --format",
    "check": "node scripts/check.mjs",
    "check:all": "node scripts/check.mjs --all"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "knip": "^6.45.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
