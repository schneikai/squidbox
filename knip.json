{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "ignore": [".claude/skills/apple-design/**"]
    },
    "apps/mobile": {
      "entry": [
        "metro.config.js",
        "playwright.config.mjs",
        "e2e/globalSetup.mjs",
        "e2e/**/*.spec.mjs",
        "scripts/*.{js,mjs}",
        "src/**/*.{web,ios,android}.{js,jsx,ts}"
      ],
      "ignore": ["src/obsolete-code/**"],
      "ignoreDependencies": ["@babel/core", "expo-updates", "expo-system-ui"],
      "ignoreUnresolved": ["babel-preset-expo"]
    },
    "apps/server": {
      "entry": ["src/db/{migrate,seed}.ts", "scripts/*.ts"]
    },
    "packages/shared": {}
  },
  "ignoreDependencies": ["prettier"]
}
