{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "ignore": [".claude/skills/apple-design/**"],
      "ignoreUnresolved": ["scripts/write-env-local.sh"]
    },
    "apps/mobile": {
      "entry": ["fingerprint.config.js", "scripts/*.{js,mjs}", "src/**/*.{web,ios,android}.{ts,tsx}"],
      "playwright": true,
      "ignoreDependencies": ["expo-system-ui", "babel-preset-expo"]
    },
    "apps/server": {
      "entry": ["src/db/{migrate,seed}.ts", "scripts/*.ts", "test/dbSetup.ts"]
    },
    "packages/shared": {}
  },
  "ignoreDependencies": ["prettier"],
  "ignoreBinaries": ["dockerd"]
}
