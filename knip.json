{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "ignore": [".claude/skills/apple-design/**"]
    },
    "apps/mobile": {
      "entry": [
        "metro.config.js",
        "fingerprint.config.js",
        "scripts/*.{js,mjs}",
        "src/**/*.{web,ios,android}.{ts,tsx}"
      ],
      "playwright": true,
      "ignoreDependencies": ["expo-system-ui"],
      "ignoreUnresolved": ["babel-preset-expo"]
    },
    "apps/server": {
      "entry": ["src/db/{migrate,seed}.ts", "scripts/*.ts"]
    },
    "packages/shared": {}
  },
  "ignoreDependencies": ["prettier"]
}
