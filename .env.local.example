# Dev client environment. Copy to `.env.local` and fill in the values.
# Metro reads `.env.local` at runtime and inlines EXPO_PUBLIC_* into the JS bundle
# served to the dev client over the tunnel.
#
# Source the real values from your password manager / EAS.
# The API URL MUST be reachable from the phone (no localhost).

EXPO_PUBLIC_API_URL=<reachable-api-url>/api/v1

EXPO_PUBLIC_LOGIN_FORM_EMAIL=user@example.com
EXPO_PUBLIC_LOGIN_FORM_PASSWORD=password

EXPO_PUBLIC_SENTRY_DEBUG=true

EXPO_PUBLIC_OPENAI_API_KEY=<openai-key>

# ngrok authtoken for the dev client tunnel (tunnel.js). Not an EXPO_PUBLIC_ var —
# read directly by the tunnel script, not inlined into the bundle.
NGROK_AUTHTOKEN=<ngrok-authtoken>
